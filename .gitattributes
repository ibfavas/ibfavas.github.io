# Exclude HTML, CSS, configs, assets, and SQL from language stats so TypeScript is 100% dominant
index.html linguist-vendored
*.html linguist-vendored
*.css linguist-vendored
*.js linguist-vendored
*.cjs linguist-vendored
*.json linguist-vendored
public/** linguist-vendored
tailwind.config.js linguist-vendored
postcss.config.js linguist-vendored
vite.config.ts linguist-vendored
vercel.json linguist-vendored

# Ensure TypeScript and TSX are explicitly recognized as the primary language
*.ts linguist-detectable=true
*.tsx linguist-detectable=true
src/**/*.ts linguist-language=TypeScript linguist-detectable=true
src/**/*.tsx linguist-language=TypeScript linguist-detectable=true
